# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml

# JavaScript / web
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
# Generated by scripts/build-version.mjs (npm run build:version).
web/version.json
# Generated by scripts/build-model-pages.mjs (npm run build:pages), which
# build:dist runs -- so both workflows regenerate these before they test or
# deploy and the committed copies were never read. Left untracked because the
# set grows with the catalog: one CHIRP submodule bump would otherwise bury the
# real change under a page-per-radio diff. Anchored for the same reason the
# build artifacts below are.
/web/radios/
/web/sitemap.xml
/web/robots.txt

# Anchored to the repo root, which is the only place these are produced. An
# unanchored build/ matches at any depth, and silently swallowed the whole
# tests/build/ suite -- new files there were never offered for commit.
/dist/
/build/
/.tmp/
/tmp/

# Local env
.env
.env.*
!.env.example

# Editor backups
*~
# Emacs lock files: symlinks to user@host:pid that exist only while a buffer is
# open, so a `git add -A` during an edit session commits a dangling symlink.
.#*

