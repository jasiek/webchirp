{
  "name": "webchirp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:version && node scripts/dev-server.mjs",
    "build:catalog": "node --experimental-wasm-stack-switching scripts/build-catalog.mjs",
    "build:version": "node scripts/build-version.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:dist": "npm run build:version && npm run build:catalog && node scripts/build-dist.mjs",
    "screenshots": "npm run build:version && node scripts/update-screenshots.mjs",
    "coverage": "node scripts/coverage.mjs",
    "coverage:patch": "node scripts/coverage-patch.mjs",
    "coverage:report": "node scripts/coverage-report.mjs",
    "coverage:show": "node scripts/coverage-report.mjs",
    "test:ci": "npm run check:syntax && npm run check:types && npm run check:python && npm run coverage",
    "ga:dimensions": "node scripts/ga-dimensions.mjs",
    "radio:read": "node --experimental-wasm-stack-switching scripts/radio-codeplug.mjs read",
    "radio:write": "node --experimental-wasm-stack-switching scripts/radio-codeplug.mjs write",
    "test": "npm run check:syntax && npm run check:types && npm run test:channels && npm run test:webusb && npm run test:settings && npm run test:build",
    "check:syntax": "find web scripts tests -name '*.js' -o -name '*.mjs' | xargs -n1 node --check",
    "check:python": "python3 -m compileall -q web/python tests/support/python_coverage.py",
    "check:types": "pyright",
    "test:channels": "node --test --experimental-wasm-stack-switching tests/channels/*.mjs",
    "test:webusb": "node --test tests/webusb/*.mjs",
    "test:build": "node --test tests/build/*.mjs",
    "test:api": "node --test tests/manual/rsgb-live.mjs",
    "test:hw": "node --experimental-wasm-stack-switching tests/manual/hw-radio.mjs",
    "test:settings": "node --test --experimental-wasm-stack-switching tests/settings/*.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^10.73.0",
    "pyodide": "^0.27.2",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "pyright": "1.1.413"
  }
}
